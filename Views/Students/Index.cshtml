@model SchoolManagementSystem.Models.ViewModels.PagedResult<SchoolManagementSystem.Models.Student>
@{
    ViewData["Title"] = "Students";
}

<div class="page-header">
    <div>
        <h1>Students</h1>
        <p>@Model.TotalCount student@(Model.TotalCount == 1 ? "" : "s") enrolled · manage admissions and records</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Add Student</a>
</div>

<div class="card">
    <!-- Search + filter -->
    <form method="get" class="toolbar">
        <div class="search-input">
            <i class="bi bi-search"></i>
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or student ID..." />
        </div>
        <select name="departmentId" asp-items="ViewBag.Departments" class="form-select" style="max-width:260px">
            <option value="">All departments</option>
        </select>
        <button class="btn btn-primary"><i class="bi bi-funnel"></i> Filter</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(Context.Request.Query["departmentId"]))
        {
            <a asp-action="Index" class="btn btn-light">Clear</a>
        }
    </form>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>#</th><th>Student</th><th>Student ID</th><th>Department</th><th>Program</th><th>Semester</th><th>Phone</th><th>Status</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @{
                        var serial = (Model.Page - 1) * Model.PageSize;
                    }
                    @foreach (var s in Model.Items)
                    {
                        <tr>
                            <td class="text-muted">@(++serial)</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@s.Id" class="person text-decoration-none text-reset">
                                    <span class="avatar @UiHelpers.TileFor(s.FullName)">@UiHelpers.Initials(s.FirstName, s.LastName)</span>
                                    <div><strong>@s.FullName</strong><small>@(s.Email ?? "No email")</small></div>
                                </a>
                            </td>
                            <td><span class="id-badge">@s.StudentId</span></td>
                            <td>@(s.Department?.Name ?? "-")</td>
                            <td>@s.Program</td>
                            <td>@s.Semester</td>
                            <td class="text-nowrap">@(s.Phone ?? "-")</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="status status-active">Active</span>
                                }
                                else
                                {
                                    <span class="status status-inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@s.Id"><i class="bi bi-eye"></i> View</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@s.Id"><i class="bi bi-pencil"></i> Edit</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@s.Id" data-name="@s.FullName" data-studentid="@s.StudentId"><i class="bi bi-trash"></i> Delete</button></li>
                                    </ul>
                                </div>
                            </td>


                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <p class="mb-3">No students found.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-person-plus"></i> Add your first student</a>
        </div>
    }
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-between align-items-center px-3 py-3">
            <small class="text-muted">
                Showing @(((Model.Page - 1) * Model.PageSize) + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount
            </small>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">Previous</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">Next</a>
                </li>
            </ul>
        </nav>
    }

</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <span class="stat-icon tile-rose mx-auto mb-3"><i class="bi bi-exclamation-triangle"></i></span>
                <h5 class="fw-bold">Delete this student?</h5>
                <p class="text-muted">This permanently removes the record. It can't be undone.</p>
                <p class="fw-semibold mb-4"><span id="deleteStudentName"></span> · <span id="deleteStudentId"></span></p>
                <form id="deleteForm" method="post" class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('deleteStudentName').textContent = button.getAttribute('data-name');
            document.getElementById('deleteStudentId').textContent = button.getAttribute('data-studentid');
            document.getElementById('deleteForm').action = '/Students/Delete/' + button.getAttribute('data-id');
        });
    </script>
}
