@model SchoolManagementSystem.Models.ViewModels.PagedResult<SchoolManagementSystem.Models.Student>
@{
    ViewData["Title"] = "Students";
}

<div class="page-header">
    <div>
        <h1>Students</h1>
        <p>@Model.TotalCount student@(Model.TotalCount == 1 ? "" : "s") enrolled · manage admissions and records</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Add Student</a>
</div>

<div class="card">
    <!-- Search + filter -->
    <form method="get" class="toolbar">
        <div class="search-input">
            <i class="bi bi-search"></i>
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or student ID..." />
        </div>
        <select name="departmentId" asp-items="ViewBag.Departments" class="form-select" style="max-width:260px">
            <option value="">All departments</option>
        </select>
        <button class="btn btn-primary"><i class="bi bi-funnel"></i> Filter</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(Context.Request.Query["departmentId"]))
        {
            <a asp-action="Index" class="btn btn-light">Clear</a>
        }
    </form>

    @if (Model.Items.Any())
    {
        var serial = (Model.Page - 1) * Model.PageSize;
        var currentUrl = Context.Request.Path + Context.Request.QueryString;
        var updatedId = TempData["UpdatedStudentId"]?.ToString() ?? Context.Request.Query["highlight"].ToString();

        <div class="table-responsive">
            <table class="table table-hover align-middle student-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Student</th>
                        <th>Student ID</th>
                        <th>Department</th>
                        <th>Program</th>
                        <th style="width: 95px;">Semester</th>
                        <th>Phone</th>
                        <th style="width: 105px;">Status</th>
                        <th class="text-end" style="width: 80px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Items)
                    {
                        var isUpdated = !string.IsNullOrEmpty(updatedId) && updatedId == s.Id.ToString();
                        <tr class="student-row @(isUpdated ? "just-updated-row" : "")" id="student-@s.Id">
                            <td class="text-muted fw-semibold">
                                @(++serial)
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@s.Id" class="person text-decoration-none text-reset">
                                    @if (!string.IsNullOrEmpty(s.ProfilePicture))
                                    {
                                        <img src="@s.ProfilePicture" alt="@s.FullName" class="avatar avatar-img shadow-sm" />
                                    }
                                    else
                                    {
                                        <span class="avatar @UiHelpers.TileFor(s.FullName)">@UiHelpers.Initials(s.FirstName, s.LastName)</span>
                                    }
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <strong>@s.FullName</strong>
                                            @if (isUpdated)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold" style="font-size: 0.7rem;">
                                                    <i class="bi bi-check2-circle"></i> Just Edited
                                                </span>
                                            }
                                        </div>
                                        <small class="text-muted">@(s.Email ?? "No email")</small>
                                    </div>
                                </a>
                            </td>
                            <td><span class="id-badge">@s.StudentId</span></td>
                            <td><i class="bi bi-building text-muted me-1"></i> @(s.Department?.Name ?? "-")</td>
                            <td>@s.Program</td>
                            <td><span class="badge bg-light text-dark border">Sem @s.Semester</span></td>
                            <td class="text-nowrap">
                                @if (!string.IsNullOrEmpty(s.Phone))
                                {
                                    <span><i class="bi bi-telephone text-muted me-1"></i>@s.Phone</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="status status-active">Active</span>
                                }
                                else
                                {
                                    <span class="status status-inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                        <i class="bi bi-three-dots-vertical fs-6"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@s.Id">
                                                <i class="bi bi-eye text-muted me-2"></i> View Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@s.Id" asp-route-returnUrl="@($"{currentUrl}#student-{s.Id}")">
                                                <i class="bi bi-pencil text-primary me-2"></i> Edit Record
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@s.Id">
                                                <i class="bi bi-trash me-2"></i> Delete Student
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <p class="mb-3">No students found.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-person-plus"></i> Add your first student</a>
        </div>
    }
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-between align-items-center px-3 py-3">
            <small class="text-muted">
                Showing @(((Model.Page - 1) * Model.PageSize) + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount
            </small>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">Previous</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">Next</a>
                </li>
            </ul>
        </nav>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var updatedId = '@(TempData["UpdatedStudentId"] ?? Context.Request.Query["highlight"])';
            var target = null;

            if (updatedId) {
                target = document.getElementById('student-' + updatedId);
            } else if (window.location.hash) {
                try {
                    target = document.querySelector(window.location.hash);
                } catch (e) { }
            }

            if (target) {
                // Smooth scroll right to the target row so it's centered in view
                setTimeout(function () {
                    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    target.classList.add('just-updated-row');
                    target.classList.add('just-updated-highlight');
                }, 200);
            }
        });
    </script>
}
