@model Student
@{
    ViewData["Title"] = "Delete Student";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body text-center p-4">
                <span class="stat-icon tile-rose mx-auto mb-3"><i class="bi bi-exclamation-triangle"></i></span>
                <h5 class="fw-bold">Delete this student?</h5>
                <p class="text-muted">This permanently removes the record. It can't be undone.</p>

                <div class="person justify-content-center text-start border rounded-3 p-3 my-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" alt="@Model.FullName" class="avatar avatar-img shadow-sm" />
                    }
                    else
                    {
                        <span class="avatar @UiHelpers.TileFor(Model.FullName)">@UiHelpers.Initials(Model.FirstName, Model.LastName)</span>
                    }
                    <div>
                        <strong>@Model.FullName</strong>
                        <small>@Model.StudentId · @(Model.Department?.Name ?? "-") · @Model.Program</small>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-center gap-2">
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
