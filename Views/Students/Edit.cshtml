@model Student
@{
    ViewData["Title"] = "Edit Student";
}

<div class="page-header">
    <div>
        <h1>Edit student</h1>
        <p>Update the record of <strong>@Model.FullName</strong> (<span class="id-badge">@Model.StudentId</span>)</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back to profile</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    <input type="hidden" asp-for="Id" />
    <div class="card-body">
        <partial name="_StudentForm" model="Model" />
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
