@model Student
@{
    ViewData["Title"] = "Student Profile";
}

<div class="page-header">
    <div>
        <h1>Student profile</h1>
        <p>Full record for @Model.FullName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
    </div>
</div>

<div class="row g-3">
    <!-- Profile card -->
    <div class="col-lg-4">
        <div class="card text-center">
            <div class="profile-cover"></div>
            <div class="card-body pt-0">
                <span class="avatar avatar-xl profile-avatar @UiHelpers.TileFor(Model.FullName)">@UiHelpers.Initials(Model.FirstName, Model.LastName)</span>
                <h5 class="mt-2 mb-1 fw-bold">@Model.FullName</h5>
                <p class="text-muted mb-2">@Model.Program</p>
                <span class="id-badge">@Model.StudentId</span>
                <div class="mt-3">
                    @if (Model.IsActive)
                    {
                        <span class="status status-active">Active</span>
                    }
                    else
                    {
                        <span class="status status-inactive">Inactive</span>
                    }
                </div>
                <hr />
                <div class="row text-center g-0">
                    <div class="col"><div class="fw-bold fs-5">@Model.Semester</div><small class="text-muted">Semester</small></div>
                    <div class="col border-start"><div class="fw-bold fs-5">@(Model.Batch ?? "-")</div><small class="text-muted">Batch</small></div>
                    <div class="col border-start"><div class="fw-bold fs-5">@(Model.Department?.Code ?? "-")</div><small class="text-muted">Dept.</small></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header"><h6 class="card-title-sm"><i class="bi bi-mortarboard me-1"></i> Academic information</h6></div>
            <div class="card-body">
                <dl class="info-list">
                    <div><dt>Department</dt><dd>@(Model.Department?.Name ?? "-")</dd></div>
                    <div><dt>Program</dt><dd>@Model.Program</dd></div>
                    <div><dt>Current semester</dt><dd>@Model.Semester</dd></div>
                    <div><dt>Admission date</dt><dd>@Model.AdmissionDate.ToString("dd MMM yyyy")</dd></div>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h6 class="card-title-sm"><i class="bi bi-person-lines-fill me-1"></i> Personal &amp; contact</h6></div>
            <div class="card-body">
                <dl class="info-list">
                    <div><dt>Gender</dt><dd>@Model.Gender</dd></div>
                    <div><dt>Date of birth</dt><dd>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")</dd></div>
                    <div><dt>Phone</dt><dd>@(Model.Phone ?? "-")</dd></div>
                    <div><dt>Email</dt><dd>@(Model.Email ?? "-")</dd></div>
                    <div><dt>Guardian</dt><dd>@(Model.GuardianName ?? "-")</dd></div>
                    <div><dt>Guardian phone</dt><dd>@(Model.GuardianPhone ?? "-")</dd></div>
                    <div class="grid-full"><dt>Address</dt><dd>@(Model.Address ?? "-")</dd></div>
                </dl>
            </div>
        </div>
    </div>
</div>
