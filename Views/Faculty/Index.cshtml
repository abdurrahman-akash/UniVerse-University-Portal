@model SchoolManagementSystem.Models.ViewModels.PagedResult<SchoolManagementSystem.Models.Faculty>
@{
    ViewData["Title"] = "Faculty";
}

<div class="page-header">
    <div>
        <h1>Faculty</h1>
        <p>@Model.TotalCount teachers across @Model.Items.Select(f => f.DepartmentId).Distinct().Count() departments</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Add Faculty</a>
</div>

<div class="card">
    <!-- Search + filter -->
    <form method="get" class="toolbar">
        <div class="search-input">
            <i class="bi bi-search"></i>
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email..." />
        </div>
        <select name="departmentId" asp-items="ViewBag.Departments" class="form-select" style="max-width:260px">
            <option value="">All departments</option>
        </select>
        <button class="btn btn-primary"><i class="bi bi-funnel"></i> Filter</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(Context.Request.Query["departmentId"]))
        {
            <a asp-action="Index" class="btn btn-light">Clear</a>
        }
    </form>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Teacher</th><th>Designation</th><th>Department</th><th>Phone</th><th>Joined</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@f.Id" class="person text-decoration-none text-reset">
                                    <span class="avatar @UiHelpers.TileFor(f.FullName)">@UiHelpers.Initials(f.FirstName, f.LastName)</span>
                                    <div><strong>@f.FullName</strong><small>@(f.Email ?? "No email")</small></div>
                                </a>
                            </td>
                            <td>
                                @{
                                    var badge = f.Designation switch
                                    {
                                        "Professor" => "bg-primary-subtle text-primary",
                                        "Associate Professor" => "bg-success-subtle text-success",
                                        "Assistant Professor" => "bg-warning-subtle text-warning-emphasis",
                                        _ => "bg-secondary-subtle text-secondary",
                                    };
                                }
                                <span class="badge rounded-pill @badge">@f.Designation</span>
                            </td>
                            <td>@(f.Department?.Name ?? "-")</td>
                            <td class="text-nowrap">@(f.Phone ?? "-")</td>
                            <td class="text-nowrap">@f.JoiningDate.ToString("MMM yyyy")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@f.Id"><i class="bi bi-eye"></i> View</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@f.Id"><i class="bi bi-pencil"></i> Edit</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@f.Id"><i class="bi bi-trash"></i> Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex justify-content-between align-items-center px-3 py-3">
                <small class="text-muted">
                    Showing @(((Model.Page - 1) * Model.PageSize) + 1) to @Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                </small>
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">Previous</a>
                    </li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-departmentId="@ViewBag.DepartmentId">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-person-badge"></i>
            <p class="mb-3">No faculty members found.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-person-plus"></i> Add your first faculty member</a>
        </div>
    }
</div>
