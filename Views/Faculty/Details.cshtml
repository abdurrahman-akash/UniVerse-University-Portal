@model Faculty
@{
    ViewData["Title"] = "Faculty Details";
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.FullName</h5>
        <a asp-action="Index" class="btn btn-sm btn-light">Back to List</a>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Designation</dt>
            <dd class="col-sm-9">@Model.Designation</dd>
            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@(Model.Department?.Name ?? "-")</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "-")</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>
            <dt class="col-sm-3">Joining Date</dt>
            <dd class="col-sm-9">@Model.JoiningDate.ToString("dd MMM yyyy")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Delete</a>
    </div>
</div>
