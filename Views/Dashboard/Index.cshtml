@using SchoolManagementSystem.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome banner -->
<div class="welcome-banner mb-4">
    <div class="row align-items-center g-3">
        <div class="col-md-8">
            <h2 class="mb-1">Welcome back, Admin 👋</h2>
            <p>Spring 2026 semester · Week 10 of 16 · @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-controller="Students" asp-action="Create" class="btn btn-light"><i class="bi bi-person-plus"></i> New Admission</a>
        </div>
    </div>
    <i class="bi bi-mortarboard banner-icon"></i>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div>
                    <p class="stat-label">Total Students</p>
                    <h3 class="stat-value">@Model.TotalStudents.ToString("N0")</h3>
                    <span class="trend text-success"><i class="bi bi-arrow-up-right"></i> 12% this semester</span>
                </div>
                <span class="stat-icon tile-blue"><i class="bi bi-people-fill"></i></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div>
                    <p class="stat-label">Faculty Members</p>
                    <h3 class="stat-value">@Model.TotalFaculty</h3>
                    <span class="trend text-muted">@Model.TotalDepartments departments</span>
                </div>
                <span class="stat-icon tile-violet"><i class="bi bi-person-badge-fill"></i></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div>
                    <p class="stat-label">Active Courses</p>
                    <h3 class="stat-value">@Model.TotalCourses</h3>
                    <span class="trend text-muted">Spring 2026</span>
                </div>
                <span class="stat-icon tile-amber"><i class="bi bi-journal-bookmark-fill"></i></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div>
                    <p class="stat-label">Fees Collected</p>
                    <h3 class="stat-value">৳ @Model.FeesCollected.ToString("N0")</h3>
                    <span class="trend text-danger">Due ৳ @Model.FeesDue.ToString("N0")</span>
                </div>
                <span class="stat-icon tile-green"><i class="bi bi-wallet2"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Left column -->
    <div class="col-xl-8">
        <div class="row g-3 mb-3">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="card-title-sm">Attendance this week</h6>
                        <span class="badge bg-secondary-subtle text-secondary">No attendance data yet</span>
                    </div>
                    <div class="card-body"><div class="chart-box"><canvas id="attChart"></canvas></div></div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-header"><h6 class="card-title-sm">Students by department</h6></div>
                    <div class="card-body"><div class="chart-box"><canvas id="deptChart"></canvas></div></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="card-title-sm">Recent admissions</h6>
                <a asp-controller="Students" asp-action="Index" class="btn btn-sm btn-light">View all <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (Model.RecentStudents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Student</th><th>Student ID</th><th>Program</th><th>Semester</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.RecentStudents)
                            {
                                <tr>
                                    <td>
                                        <div class="person">
                                            <span class="avatar @UiHelpers.TileFor(s.FullName)">@UiHelpers.Initials(s.FirstName, s.LastName)</span>
                                            <div><strong>@s.FullName</strong><small>@s.Program</small></div>
                                        </div>
                                    </td>
                                    <td><span class="id-badge">@s.StudentId</span></td>
                                    <td>@s.Program</td>
                                    <td>@s.Semester</td>
                                    <td><span class="status status-active">Active</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state"><i class="bi bi-people"></i>No recent students found.</div>
            }
        </div>
    </div>

    <!-- Right column -->
    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header"><h6 class="card-title-sm">Quick actions</h6></div>
            <div class="card-body">
                <div class="quick-actions">
                    <a class="quick-action" asp-controller="Students" asp-action="Create"><i class="bi bi-person-plus text-primary"></i>Add Student</a>
                    <a class="quick-action" asp-controller="Faculty" asp-action="Create"><i class="bi bi-person-badge text-success"></i>Add Faculty</a>
                    <a class="quick-action" asp-controller="Departments" asp-action="Create"><i class="bi bi-building-add text-warning"></i>Add Department</a>
                    <a class="quick-action" asp-controller="Students" asp-action="Index"><i class="bi bi-search text-danger"></i>Find Student</a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="card-title-sm"><i class="bi bi-megaphone me-1"></i> Notice board</h6>
                <span class="badge bg-primary-subtle text-primary">@Model.RecentNotices.Count new</span>
            </div>
            @if (Model.RecentNotices.Any())
            {
                foreach (var n in Model.RecentNotices)
                {
                    <div class="notice-item">
                        <div class="notice-date">
                            <b>@n.PublishDate.Day</b>
                            <small>@n.PublishDate.ToString("MMM")</small>
                        </div>
                        <div>
                            <strong class="d-block">@n.Title</strong>
                            <small class="text-muted d-block mb-1">For: @n.Audience</small>
                            <span class="small">@n.Description</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><i class="bi bi-megaphone"></i>No notices yet.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart.js charts (sample numbers for the prototype)
        Chart.defaults.font.family = "Inter, system-ui, sans-serif";
        Chart.defaults.color = "#6b7385";
        Chart.defaults.maintainAspectRatio = false; // fill the .chart-box height instead

        const att = document.getElementById('attChart');
        if (att) new Chart(att, {
            type: 'bar',
            data: {
                labels: ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu'],
                datasets: [{ label: 'Present', data: [820, 935, 928, 942, 938, 945], backgroundColor: '#2563eb', borderRadius: 8, maxBarThickness: 34 }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, grid: { color: '#eef1f6' } }, x: { grid: { display: false } } }
            }
        });

        const dept = document.getElementById('deptChart');
        if (dept) new Chart(dept, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentsByDepartment.Select(d => d.Code))),
                datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentsByDepartment.Select(d => d.Count))), backgroundColor: ['#2563eb', '#16a34a', '#f59e0b', '#7c3aed', '#e11d48', '#0ea5e9'], borderWidth: 0 }]
            },
            options: { cutout: '68%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } } }
        });

    </script>
}
