@model List<(SchoolManagementSystem.Models.AppUser User, string Roles)>
@{
    ViewData["Title"] = "User Management";
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Users (@Model.Count)</h5>
        <a asp-action="Create" class="btn btn-primary">+ Add User</a>
    </div>
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.User.FullName</td>
                        <td>@item.User.Email</td>
                        <td><span class="badge text-bg-light border">@item.Roles</span></td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@item.User.Id" method="post" onsubmit="return confirm('Delete this user?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
