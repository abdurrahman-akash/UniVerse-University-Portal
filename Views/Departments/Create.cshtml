@model Department
@{
    ViewData["Title"] = "Add Department";
}

<div class="page-header">
    <div>
        <h1>Add department</h1>
        <p>Create a new academic department.</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back to departments</a>
</div>

<form asp-action="Create" method="post" class="card" style="max-width: 760px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <h6 class="form-section-title"><i class="bi bi-building"></i> Department details</h6>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label">Department name</label>
                <input asp-for="Name" class="form-control" placeholder="Computer Science and Engineering" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Code" class="form-label">Short code</label>
                <input asp-for="Code" class="form-control text-uppercase" placeholder="CSE" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="HeadOfDepartment" class="form-label">Head of department</label>
                <input asp-for="HeadOfDepartment" class="form-control" placeholder="Prof. Dr. ..." />
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save department</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
