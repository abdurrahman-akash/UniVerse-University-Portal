@model List<Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="page-header">
    <div>
        <h1>Departments</h1>
        <p>@Model.Count academic departments</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-building-add"></i> Add Department</a>
</div>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var d in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card dept-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="dept-code @UiHelpers.TileFor(d.Code)">@d.Code</span>
                            <div class="min-w-0 flex-grow-1">
                                <h6 class="fw-bold mb-0">@d.Name</h6>
                                <small class="text-muted">Department of @d.Code</small>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@d.Id"><i class="bi bi-eye"></i> View</a></li>
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@d.Id"><i class="bi bi-pencil"></i> Edit</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@d.Id"><i class="bi bi-trash"></i> Delete</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 text-muted small mb-3">
                            <i class="bi bi-person-workspace"></i>
                            <span>Head: <strong class="text-body">@(d.HeadOfDepartment ?? "Not assigned")</strong></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <span><strong class="fs-5">@d.Students.Count</strong> <small class="text-muted">students</small></span>
                            <a asp-controller="Students" asp-action="Index" asp-route-departmentId="@d.Id" class="btn btn-sm btn-light">View students <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card"><div class="empty-state"><i class="bi bi-building"></i>No departments yet.</div></div>
}
